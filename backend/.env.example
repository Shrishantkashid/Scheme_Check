# Port opened by Express. For EC2, allow this TCP port in the instance security group.
PORT=5000

# MongoDB connection string used by the backend.
MONGODB_URI=mongodb://127.0.0.1:27017/scheme_check

# Required for Groq-powered translation/voice features.
GROQ_API_KEY=your_groq_api_key

# Required for scraping myscheme API (can be rotated by government)
MYSCHEME_API_KEY=your_myscheme_api_key

# Optional comma-separated allowed frontend origins.
# Leave unset to allow all origins during Expo/mobile development.
CORS_ORIGIN=
